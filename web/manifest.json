{
  "manifest_version": 3,
  "name": "Scolect – Screen Time & Website Tracker",
  "short_name": "Scolect",
  "description": "Track time spent on websites, set daily limits, block distracting sites, and run focus sessions. Open source screen time tracker.",
  "version": "2.2.1",

  "icons": {
    "16":  "icons/Icon-16.png",
    "32":  "icons/Icon-32.png",
    "48":  "icons/Icon-48.png",
    "128": "icons/Icon-192.png",
    "512": "icons/Icon-512.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/Icon-16.png",
      "32":  "icons/Icon-32.png",
      "48":  "icons/Icon-48.png",
      "128": "icons/Icon-192.png"
    },
    "default_title": "Scolect – Screen Time Tracker"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "activeTab",
    "notifications",
    "idle"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:46000/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_block.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "flutter.js",
        "flutter_bootstrap.js",
        "main.dart.js",
        "assets/**",
        "canvaskit/**",
        "icons/**",
        "favicon.png",
        "blocked.html",
        "blocked.js",
        "content_block.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
