{
  "manifest_version": 3,
  "name": "Scolect – Web Time Tracker",
  "short_name": "Scolect",
  "description": "Track your website usage. Dashboard powered by Flutter.",
  "version": "1.0.0",

  "icons": {
    "16":  "icons/Icon-192.png",
    "32":  "icons/Icon-192.png",
    "48":  "icons/Icon-192.png",
    "128": "icons/Icon-512.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/Icon-192.png",
      "32":  "icons/Icon-192.png",
      "48":  "icons/Icon-192.png",
      "128": "icons/Icon-512.png"
    },
    "default_title": "Scolect – Web Time Tracker"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:46000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "flutter.js",
        "flutter_bootstrap.js",
        "main.dart.js",
        "assets/**",
        "canvaskit/**",
        "icons/**",
        "favicon.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
